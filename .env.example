# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# Google AI Studio key (Gemini text + TTS): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cloudflare Workers AI: account id from the dashboard URL, token with "Workers AI" permission
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Kaggle (GPU stages). Either put kaggle.json in ~/.kaggle/ or set these.
KAGGLE_USERNAME=
KAGGLE_KEY=
